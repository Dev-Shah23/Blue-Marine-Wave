# ── Frontend (build-time, embedded in the client bundle — never put secrets here) ──
# Leave BLANK to use the same-origin Vercel function at /api/contact (recommended).
# Only set this if the backend lives on a different origin.
REACT_APP_BACKEND_URL=

# ── Backend: /api/contact booking intake (set these in Vercel, not in the bundle) ──
# Without RESEND_API_KEY the form still works — bookings are written to the logs.
RESEND_API_KEY=
LEAD_NOTIFY_EMAIL=export@bluewavemarine.in
LEAD_FROM_EMAIL=onboarding@resend.dev
# "true" to also email the client a confirmation with their booking reference.
SEND_CLIENT_CONFIRMATION=false
# Durable bookings log: a URL that records each booking (e.g. a Google Apps Script
# that appends to a Sheet, a Zapier/Make webhook, or a Slack incoming webhook).
# Strongly recommended so no booking is ever lost. See api/README.md for a recipe.
BOOKING_WEBHOOK_URL=
# Lock CORS to your origin in production, e.g. https://bluewavemarine.in
ALLOWED_ORIGIN=
